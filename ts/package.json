{
  "name": "ivo",
  "author": "kamtoeddy",
  "description": "The schema valitator that brings user stories to life",
  "version": "2.0.1",
  "scripts": {
    "build": "tsdown",
    "build:dev": "tsdown",
    "build:watch": "tsdown --watch",
    "clean": "rm -rf coverage dist",
    "cleanup": "bun run typecheck && bun run typecheck:test && bun run lint",
    "lint": "clear; bunx @biomejs/biome check --write .",
    "test": "bun run build && bun test",
    "test:cov": "bun run build && bun test --coverage",
    "test:watch": "bun run build && bun test --watch",
    "typecheck": "clear; tsc --noEmit -p ./tsconfig.json",
    "typecheck:test": "clear; tsc --noEmit -p tests/tsconfig.json"
  },
  "license": "MIT",
  "homepage": "https://ivo.kamtoeddy.com/docs/ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kamtoeddy/ivo.git"
  },
  "readme": "README.md",
  "bugs": {
    "url": "https://github.com/kamtoeddy/ivo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "schema",
    "validation"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "^1.4.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
